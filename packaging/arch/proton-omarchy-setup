#!/usr/bin/bash
set -euo pipefail

SERVICE="proton-omarchy-agent.service"
SOCKET="proton-omarchy-agent.socket"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
LIFECYCLE_FILE="$CONFIG_HOME/proton-vpn-omarchy/lifecycle.json"
LEGACY_PLUGIN_LINK="$CONFIG_HOME/omarchy/plugins/proton.omarchy"
LEGACY_PLUGIN_SOURCE="/usr/share/proton-vpn-omarchy/plugin"
PLUGIN_URL="https://github.com/48hoursnonstop/proton-vpn-omarchy.git"

die() {
  printf 'proton-omarchy-setup: %s\n' "$*" >&2
  exit 1
}

require_user() {
  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    die "run this command as the desktop user, not as root"
  fi
}

require_systemd() {
  command -v systemctl >/dev/null || die "systemctl is required"
}

lifecycle_disables_autostart() {
  [[ -f "$LIFECYCLE_FILE" ]] &&
    grep -Eq '"start_with_omarchy"[[:space:]]*:[[:space:]]*false' "$LIFECYCLE_FILE"
}

remove_legacy_package_plugin_link() {
  [[ -L "$LEGACY_PLUGIN_LINK" ]] || return 0
  local target
  target="$(readlink "$LEGACY_PLUGIN_LINK" 2>/dev/null || true)"
  if [[ "$target" == "$LEGACY_PLUGIN_SOURCE" ]]; then
    rm "$LEGACY_PLUGIN_LINK"
    printf 'Removed the obsolete package-managed frontend link.\n'
    if command -v omarchy-shell >/dev/null 2>&1; then
      omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    fi
  fi
}

configure_agent_units() {
  local refresh="${1:-false}"
  systemctl --user daemon-reload
  systemctl --user enable --now "$SOCKET"

  if lifecycle_disables_autostart; then
    systemctl --user disable --now "$SERVICE" >/dev/null 2>&1 || true
  elif [[ "$refresh" == "true" ]] &&
       systemctl --user is-active "$SERVICE" >/dev/null 2>&1; then
    systemctl --user enable "$SERVICE" >/dev/null
    systemctl --user restart "$SERVICE"
  else
    systemctl --user enable --now "$SERVICE"
  fi
}

install_backend() {
  require_user
  require_systemd
  remove_legacy_package_plugin_link
  configure_agent_units false
  printf 'Enabled the Proton VPN user agent and on-demand socket.\n'
}

install_all_compat() {
  install_backend
  printf 'The frontend is now distributed independently. Install it with:\n'
  printf '  omarchy plugin add %s --enable\n' "$PLUGIN_URL"
}

refresh_backend() {
  require_user
  require_systemd
  remove_legacy_package_plugin_link
  configure_agent_units true
  printf 'Refreshed the Proton VPN backend and preserved its auto-start preference.\n'
}

uninstall_backend() {
  require_user
  systemctl --user disable --now "$SERVICE" >/dev/null 2>&1 || true
  systemctl --user disable --now "$SOCKET" >/dev/null 2>&1 || true
  remove_legacy_package_plugin_link
  printf 'Disabled Proton VPN for Omarchy backend services.\n'
  printf 'The independently installed Omarchy plugin was not modified.\n'
}

show_status() {
  require_user
  printf 'Agent enabled: '
  systemctl --user is-enabled "$SERVICE" 2>/dev/null || true
  printf 'Agent active: '
  systemctl --user is-active "$SERVICE" 2>/dev/null || true
  printf 'On-demand socket enabled: '
  systemctl --user is-enabled "$SOCKET" 2>/dev/null || true
  printf 'On-demand socket active: '
  systemctl --user is-active "$SOCKET" 2>/dev/null || true
  printf 'Frontend: independently managed by Omarchy plugins\n'
}

usage() {
  cat <<'EOF'
Usage: proton-omarchy-setup <command>

Commands:
  backend    Configure the per-user agent and on-demand socket.
  install    Backward-compatible alias for backend; prints the UI install command.
  refresh    Reload/restart the backend while preserving the auto-start preference.
  uninstall  Disable only backend services; never removes the independent UI.
  status     Show backend service status.

Run this helper as the desktop user. It never needs sudo.
EOF
}

case "${1:-}" in
  backend) install_backend ;;
  install) install_all_compat ;;
  refresh) refresh_backend ;;
  uninstall) uninstall_backend ;;
  status) show_status ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
