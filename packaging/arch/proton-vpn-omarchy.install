post_install() {
  systemctl daemon-reload
  systemctl enable --now proton.VPN.service
  echo ":: Proton VPN for Omarchy core is installed."
  echo ":: As the Omarchy desktop user, finish backend setup with:"
  echo "   proton-omarchy-setup backend"
  echo ":: Install the independent UI with:"
  echo "   omarchy plugin add https://github.com/48hoursnonstop/proton-vpn-omarchy.git --enable"
}

post_upgrade() {
  systemctl daemon-reload
  systemctl restart proton.VPN.service
  echo ":: Proton VPN for Omarchy core was upgraded."
  echo ":: As the desktop user, run: proton-omarchy-setup refresh"
}

pre_remove() {
  systemctl disable --now proton.VPN.service
  rm -rf -- /var/lib/proton-vpn-omarchy
  echo ":: Removed Proton VPN for Omarchy system services and system state."
  echo ":: User state is removed by the plugin's clean-uninstall action."
}

post_remove() {
  systemctl daemon-reload
}
