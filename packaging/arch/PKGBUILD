pkgname=proton-vpn-omarchy
pkgver=0.8.7
pkgrel=1
pkgdesc="Native Proton VPN backend and Rust split tunneling service for Omarchy Quattro"
url="https://github.com/48hoursnonstop/proton-vpn-omarchy-core"
arch=('x86_64')
license=('GPL-3.0-or-later')
provides=('proton-vpn-daemon=0.13.8')
conflicts=('proton-vpn-daemon')
depends=(
  'iproute2'
  'networkmanager'
  'networkmanager-vpn-plugin-openvpn'
  'openvpn'
  'python-proton-vpn-api-core>=5.5.11'
)
makedepends=('rust>=1.75')
# Rust already performs ThinLTO at the crate graph level. Arch's additional
# C/C++ LTO breaks ring's native archive propagation during the final Rust link.
options=('!debug' '!lto')
install=proton-vpn-omarchy.install
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('4523f5826c55c2b3a647c3469427db8e856f421033a74f49015c0176ef9ca31a')

build() {
  cd "$pkgname-$pkgver"
  cargo build --frozen --release --package proton-omarchy-agent
  cargo build --frozen --release --package proton-omarchy-splitd
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen --workspace
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/proton-omarchy-agent \
    "$pkgdir/usr/bin/proton-omarchy-agent"
  install -Dm755 target/release/proton-omarchy-splitd \
    "$pkgdir/usr/lib/proton-vpn-omarchy/proton-omarchy-splitd"
  install -Dm755 packaging/arch/proton-omarchy-setup \
    "$pkgdir/usr/bin/proton-omarchy-setup"
  install -Dm755 packaging/arch/proton-omarchy-protun-metadata \
    "$pkgdir/usr/lib/proton-vpn-omarchy/proton-omarchy-protun-metadata"
  install -Dm644 packaging/arch/proton-omarchy-protun-metadata.hook \
    "$pkgdir/usr/share/libalpm/hooks/proton-omarchy-protun-metadata.hook"

  install -Dm644 packaging/systemd/proton-omarchy-agent.service \
    "$pkgdir/usr/lib/systemd/user/proton-omarchy-agent.service"
  install -Dm644 packaging/systemd/proton-omarchy-agent.socket \
    "$pkgdir/usr/lib/systemd/user/proton-omarchy-agent.socket"
  install -Dm644 packaging/systemd/proton.VPN.service \
    "$pkgdir/usr/lib/systemd/system/proton.VPN.service"
  install -Dm644 packaging/dbus/me.proton.vpn.split_tunneling.service \
    "$pkgdir/usr/share/dbus-1/system-services/me.proton.vpn.split_tunneling.service"
  install -Dm644 packaging/dbus/me.proton.vpn.split_tunneling.conf \
    "$pkgdir/usr/share/dbus-1/system.d/me.proton.vpn.split_tunneling.conf"

  install -d "$pkgdir/usr/share/proton-vpn-omarchy/status"
  install -m644 assets/status/*.webp \
    "$pkgdir/usr/share/proton-vpn-omarchy/status/"

  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 protocol/schema.md \
    "$pkgdir/usr/share/doc/$pkgname/protocol-schema.md"
  install -Dm644 reference/PLUGIN_FIRST_PRODUCT_CONTRACT_2026-08-24.md \
    "$pkgdir/usr/share/doc/$pkgname/product-contract.md"
  install -Dm644 reference/plugin-capability-boundaries-2026-08-26.json \
    "$pkgdir/usr/share/doc/$pkgname/capability-boundaries.json"
  install -Dm644 reference/plugin-feature-completeness-2026-08-26.json \
    "$pkgdir/usr/share/doc/$pkgname/feature-completeness.json"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
